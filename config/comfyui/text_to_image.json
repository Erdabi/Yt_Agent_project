{
  "output_node_title": "SaveImage",
  "workflow": {
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "v1-5-pruned-emaonly.safetensors"
      }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": "{{WIDTH}}",
        "height": "{{HEIGHT}}",
        "batch_size": 1
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{PROMPT}}",
        "clip": ["4", 1]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{NEGATIVE_PROMPT}}",
        "clip": ["4", 1]
      }
    },
    "3": {
      "class_type": "KSampler",
      "_meta": {
        "title": "BaseSampler"
      },
      "inputs": {
        "seed": "{{SEED}}",
        "steps": "{{STEPS}}",
        "cfg": "{{CFG}}",
        "sampler_name": "{{SAMPLER}}",
        "scheduler": "{{SCHEDULER}}",
        "denoise": 1,
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0]
      }
    },
    "12": {
      "class_type": "VAEDecode",
      "_meta": {
        "title": "BaseDecode"
      },
      "inputs": {
        "samples": ["3", 0],
        "vae": ["4", 2]
      }
    },
    "10": {
      "class_type": "ImageScale",
      "_meta": {
        "title": "HiresUpscale"
      },
      "inputs": {
        "image": ["12", 0],
        "upscale_method": "lanczos",
        "width": "{{UPSCALE_WIDTH}}",
        "height": "{{UPSCALE_HEIGHT}}",
        "crop": "disabled"
      }
    },
    "13": {
      "class_type": "VAEEncode",
      "_meta": {
        "title": "HiresEncode"
      },
      "inputs": {
        "pixels": ["10", 0],
        "vae": ["4", 2]
      }
    },
    "11": {
      "class_type": "KSampler",
      "_meta": {
        "title": "HiresSampler"
      },
      "inputs": {
        "seed": "{{SEED}}",
        "steps": "{{HIRES_STEPS}}",
        "cfg": "{{CFG}}",
        "sampler_name": "{{SAMPLER}}",
        "scheduler": "{{SCHEDULER}}",
        "denoise": "{{HIRES_DENOISE}}",
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["13", 0]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["11", 0],
        "vae": ["4", 2]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "_meta": {
        "title": "SaveImage"
      },
      "inputs": {
        "filename_prefix": "{{FILENAME_PREFIX}}",
        "images": ["8", 0]
      }
    }
  }
}
