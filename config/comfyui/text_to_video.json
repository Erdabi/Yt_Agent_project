{
  "output_node_title": "VideoCombine",
  "workflow": {
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "v1-5-pruned-emaonly.safetensors"
      }
    },
    "10": {
      "class_type": "ADE_AnimateDiffLoaderWithContext",
      "inputs": {
        "model": ["4", 0],
        "model_name": "mm_sd_v15_v2.ckpt",
        "beta_schedule": "sqrt_linear (AnimateDiff)",
        "context_options": null
      }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": "{{WIDTH}}",
        "height": "{{HEIGHT}}",
        "batch_size": "{{FRAME_COUNT}}"
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{PROMPT}}",
        "clip": ["4", 1]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "text, watermark, logo, signature, low quality, blurry, deformed, static",
        "clip": ["4", 1]
      }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "seed": "{{SEED}}",
        "steps": "{{STEPS}}",
        "cfg": 7.5,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1,
        "model": ["10", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["3", 0],
        "vae": ["4", 2]
      }
    },
    "11": {
      "class_type": "VHS_VideoCombine",
      "_meta": {
        "title": "VideoCombine"
      },
      "inputs": {
        "images": ["8", 0],
        "frame_rate": 8,
        "loop_count": 0,
        "filename_prefix": "{{FILENAME_PREFIX}}",
        "format": "video/h264-mp4",
        "pix_fmt": "yuv420p",
        "crf": 19,
        "save_output": true
      }
    }
  }
}
