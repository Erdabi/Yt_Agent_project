# Copy this file to `.env` and fill in real values before running
# `docker compose up`. Every variable here is read by libs/core/config.py —
# that module is the single source of truth if this file and the code
# ever disagree.
#
# .env is gitignored. Never commit real secrets.

# --- Identity ---------------------------------------------------------
# APP_ENV gates behavior that should differ between a laptop and a real
# deployment (e.g. log format). SERVICE_NAME is overridden per-service in
# docker-compose.yml — leave it as "app" here for local tooling like
# `alembic` that runs outside a specific service's container.
APP_ENV=local
SERVICE_NAME=app
LOG_LEVEL=INFO

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=yt_agent
POSTGRES_USER=yt_agent
POSTGRES_PASSWORD=change-me-locally
DATABASE_POOL_SIZE=5

# --- Redis (Celery broker + result backend) ----------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_BROKER_DB=0
REDIS_RESULT_BACKEND_DB=1

# --- Job/agent execution policy -----------------------------------------
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF_SECONDS=10

# --- Error tracking -------------------------------------------------------
# Leave blank locally. Set this in staging/production.
SENTRY_DSN=

# --- AI provider credentials --------------------------------------------
# Intentionally not listed yet: no agent in this codebase calls an AI
# provider API yet (see docs/architecture/06-roadmap.md, Phase 1). Provider
# credentials will be added here — one variable per provider, referenced by
# name from the `provider_configs.secret_ref` column — as each concrete
# agent's provider integration is implemented, not before.
