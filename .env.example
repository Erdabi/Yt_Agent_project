# Copy this file to `.env` and fill in real values before running
# `docker compose up`. Every variable here is read by libs/core/config.py —
# that module is the single source of truth if this file and the code
# ever disagree.
#
# .env is gitignored. Never commit real secrets.

# --- Identity ---------------------------------------------------------
# APP_ENV gates behavior that should differ between a laptop and a real
# deployment (e.g. log format). SERVICE_NAME is overridden per-service in
# docker-compose.yml — leave it as "app" here for local tooling like
# `alembic` that runs outside a specific service's container.
APP_ENV=local
SERVICE_NAME=app
LOG_LEVEL=INFO

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=yt_agent
POSTGRES_USER=yt_agent
POSTGRES_PASSWORD=change-me-locally
DATABASE_POOL_SIZE=5

# --- Redis (Celery broker + result backend) ----------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_BROKER_DB=0
REDIS_RESULT_BACKEND_DB=1

# --- Manager Agent: workflow retry policy -------------------------------
# How many times the Manager retries a failed pipeline stage (by
# redispatching it as a fresh job) before escalating to human review,
# regardless of what the reasoning engine itself would otherwise decide.
JOB_MAX_RETRIES=3

# --- Error tracking -------------------------------------------------------
# Leave blank locally. Set this in staging/production.
SENTRY_DSN=

# --- Manager Agent: Claude reasoning engine -----------------------------
# Used by services/orchestrator/app/manager/reasoning.py to decide
# advance/retry/escalate/abort at every pipeline stage transition. Without
# a key, the Manager still runs — it falls back to a deterministic rule
# (see reasoning.py) instead of failing outright.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low

# --- Analytics Agent: independent scheduling -----------------------------
# How often (in hours) the Analytics Agent's own Celery beat schedule
# sweeps PUBLISHED projects and pulls fresh metrics. Entirely decoupled
# from the Manager/pipeline — see services/agent_analytics/app/worker.py.
ANALYTICS_SWEEP_INTERVAL_HOURS=6

# --- Centralized asset storage (libs/storage) -----------------------------
# Every media artifact an agent produces (audio, storyboard images,
# renders, thumbnails) is written here, keyed by project id. STORAGE_ROOT
# is a path inside each container — bind-mount/volume it in docker-compose.yml
# once a real media-producing agent exists to persist it across restarts.
STORAGE_BACKEND=local
STORAGE_ROOT=data

# --- Provider configuration system (libs/providers) -----------------------
# Which concrete class backs each swappable capability (video generation,
# TTS, image generation, YouTube) — see config/providers.yaml and
# libs/providers/registry.py. Only the path is an env var; provider
# selection itself lives in that YAML file's "active" line by default.
PROVIDERS_CONFIG_PATH=config/providers.yaml

# Optional per-environment override of any capability's active provider,
# without editing config/providers.yaml at all — named
# `{CAPABILITY}_PROVIDER` (uppercased). Leave unset to use the YAML
# file's "active" line. Example: uncomment to switch video generation to
# Runway (requires RUNWAY_API_KEY below) in this environment only.
# VIDEO_GEN_PROVIDER=runway

# --- video_gen provider credentials ---------------------------------------
# Referenced by name from config/providers.yaml's video_gen.<name>.secret_ref
# — leave blank until you actually have an account with that vendor.
# `runway` is the only one with a real, working adapter today
# (libs/providers/video_gen/runway_provider.py); `invideo`/`veo` are
# honest stubs (see their own modules) and these vars are unused until
# real implementations land behind them.
RUNWAY_API_KEY=
INVIDEO_API_KEY=
GOOGLE_VEO_API_KEY=

# --- Prompt Management System (libs/prompts) ------------------------------
# Root directory of versioned prompt template files, and per-agent version
# pins ("latest" resolves to the highest vN present on disk) — see
# prompts/README.md.
PROMPTS_ROOT=prompts
MANAGER_PROMPT_VERSION=latest
SCRIPT_PROMPT_VERSION=latest

# --- AI provider credentials --------------------------------------------
# Intentionally not listed yet beyond the above: no *worker* agent in this
# codebase calls an AI provider API yet (see docs/architecture/06-roadmap.md,
# Phase 1). Provider credentials will be added here — one variable per
# provider, referenced by name from the `provider_configs.secret_ref`
# column — as each concrete agent's provider integration is implemented.
