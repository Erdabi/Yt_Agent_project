# Copy this file to `.env` and fill in real values before running
# anything (`alembic upgrade head`, `uvicorn`, a Celery worker, `pytest`).
# Every variable here is read by libs/core/config.py — that module is the
# single source of truth if this file and the code ever disagree.
#
# Defaults below assume a local, non-Docker setup: PostgreSQL and Redis
# installed and running directly on this machine (e.g. via WSL/apt),
# Ollama/ComfyUI Desktop likewise. Point POSTGRES_HOST/REDIS_HOST/etc. at
# a different host if any of these run elsewhere (a container, a remote
# box) instead.
#
# .env is gitignored. Never commit real secrets.

# --- Identity ---------------------------------------------------------
# APP_ENV gates behavior that should differ between a laptop and a real
# deployment (e.g. log format). SERVICE_NAME distinguishes one running
# process from another in log output (e.g. "orchestrator",
# "agent_research") — leave it as "app" here for local tooling like
# `alembic` that isn't any one specific long-running service; set it
# per-process (per-terminal, per-supervisor-entry) when actually running
# the orchestrator or an agent worker.
APP_ENV=local
SERVICE_NAME=app
LOG_LEVEL=INFO

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yt_agent
POSTGRES_USER=yt_agent
POSTGRES_PASSWORD=yt_agent
DATABASE_POOL_SIZE=5

# --- Redis (Celery broker + result backend) ----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_BROKER_DB=0
REDIS_RESULT_BACKEND_DB=1

# --- Manager Agent: workflow retry policy -------------------------------
# How many times the Manager retries a failed pipeline stage (by
# redispatching it as a fresh job) before escalating to human review,
# regardless of what the reasoning engine itself would otherwise decide.
JOB_MAX_RETRIES=3

# --- Error tracking -------------------------------------------------------
# Leave blank locally. Set this in staging/production.
SENTRY_DSN=

# --- Manager Agent: LLM reasoning engine -----------------------------
# Used by services/orchestrator/app/manager/reasoning.py to decide
# advance/retry/escalate/abort at every pipeline stage transition. Without
# a usable `llm` provider (see PROVIDER CONFIGURATION below), the Manager
# still runs — it falls back to a deterministic rule (see reasoning.py)
# instead of failing outright.
#
# ANTHROPIC_API_KEY is only needed if you flip llm.active (or
# LLM_PROVIDER) to "anthropic" in config/providers.yaml — the default
# `llm` provider is now local Ollama (OLLAMA_URL/OLLAMA_MODEL below),
# which needs no API key at all. Every reasoning call site in this
# codebase (Research/Script/Thumbnail agents, the Manager, Quality
# Control) goes through the same swappable `libs.providers.get_provider
# ("llm")` registry entry, so leaving this blank does not disable
# anything — it just means the "anthropic" provider entry isn't usable
# until it's set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low

# --- Local providers: Ollama (llm), ComfyUI (video_gen/image_gen) --------
# No API key required for any of these — all three are local, self-hosted
# services this stack talks to over plain HTTP. Defaults assume they run
# on this same machine; point these at a remote host/port if they run
# elsewhere.
#
# OLLAMA_MODEL must already be pulled (`ollama pull qwen3:32b`) before
# selecting "ollama" as the active llm provider — see
# libs/providers/llm/ollama_provider.py.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:32b

# ComfyUI Desktop (or any ComfyUI instance) — see config/comfyui/README.md
# for how video_gen/image_gen's workflow templates work against this.
COMFYUI_URL=http://127.0.0.1:8188

# --- Local providers: Kokoro (tts) -----------------------------------------
# No URL/key here — Kokoro (libs/providers/tts/kokoro_provider.py) runs
# in-process via the `kokoro` Python package (pip install kokoro), not a
# separate server. Its voice/language/speed are configured directly in
# config/providers.yaml's tts.kokoro.config block instead of env vars,
# the same as every other provider's non-secret settings.

# --- Analytics Agent: independent scheduling -----------------------------
# How often (in hours) the Analytics Agent's own Celery beat schedule
# sweeps PUBLISHED projects and pulls fresh metrics. Entirely decoupled
# from the Manager/pipeline — see services/agent_analytics/app/worker.py.
ANALYTICS_SWEEP_INTERVAL_HOURS=6

# --- Centralized asset storage (libs/storage) -----------------------------
# Every media artifact an agent produces (audio, storyboard images,
# renders, thumbnails) is written here, keyed by project id. A relative
# path resolves against whatever directory the process was started from —
# point this at an absolute path if you run services from different
# working directories and want them all to share the same asset store.
STORAGE_BACKEND=local
STORAGE_ROOT=data

# --- Provider configuration system (libs/providers) -----------------------
# Which concrete class backs each swappable capability (video generation,
# TTS, image generation, YouTube) — see config/providers.yaml and
# libs/providers/registry.py. Only the path is an env var; provider
# selection itself lives in that YAML file's "active" line by default.
PROVIDERS_CONFIG_PATH=config/providers.yaml

# Optional per-environment override of any capability's active provider,
# without editing config/providers.yaml at all — named
# `{CAPABILITY}_PROVIDER` (uppercased). Leave unset to use the YAML
# file's "active" line. Examples: uncomment to switch video generation to
# Runway (requires RUNWAY_API_KEY below), or narration to ElevenLabs
# (requires ELEVENLABS_API_KEY below), in this environment only. Note
# the capability is "tts", not "voice" — every other reference to it in
# this codebase (config/providers.yaml, ProviderCapability) uses that
# name, so the override env var matches it too.
# VIDEO_GEN_PROVIDER=runway
# TTS_PROVIDER=elevenlabs

# --- Render profiles (libs/providers/editor) -------------------------------
# Named, reusable output-format bundles (resolution, fps, loudness
# target, crossfade, subtitle sizing) the ffmpeg compositor renders
# against — see config/render_profiles.yaml and
# libs/providers/editor/profiles.py. Only the path is an env var; which
# profile a given render uses is chosen per call (Rendering defaults to
# "long_form_1080p" today).
RENDER_PROFILES_PATH=config/render_profiles.yaml

# --- video_gen provider credentials ---------------------------------------
# Referenced by name from config/providers.yaml's video_gen.<name>.secret_ref
# — leave blank until you actually have an account with that vendor. The
# default `video_gen` provider (`comfyui`) needs none of these — it's
# local (see COMFYUI_URL above). `runway` is a real, working cloud
# adapter (libs/providers/video_gen/runway_provider.py) for when a paid
# vendor is preferred over local generation; `invideo`/`veo` are honest
# stubs (see their own modules) and these vars are unused until real
# implementations land behind them.
RUNWAY_API_KEY=
INVIDEO_API_KEY=
GOOGLE_VEO_API_KEY=

# --- tts provider credentials ----------------------------------------------
# Referenced by name from config/providers.yaml's tts.<name>.secret_ref —
# leave blank until you actually have an account with that vendor. The
# default `tts` provider (`kokoro`) needs none of these — it's local (see
# the Kokoro section above). `elevenlabs` is a real, working cloud
# adapter (libs/providers/tts/elevenlabs_provider.py) for when a paid
# vendor is preferred over local synthesis; `azure_speech` is an honest
# stub (see its own module) and this var is unused until a real
# implementation lands behind it.
ELEVENLABS_API_KEY=
AZURE_SPEECH_API_KEY=

# --- Prompt Management System (libs/prompts) ------------------------------
# Root directory of versioned prompt template files, and per-agent version
# pins ("latest" resolves to the highest vN present on disk) — see
# prompts/README.md.
PROMPTS_ROOT=prompts
MANAGER_PROMPT_VERSION=latest
SCRIPT_PROMPT_VERSION=latest
THUMBNAIL_PROMPT_VERSION=latest

# --- Thumbnail Agent (services/agent_video/app/thumbnail_agent.py) -------
# How many thumbnail concepts Claude proposes per call, and how many of
# those (best-ranked first) actually get rendered into real images via
# the configured image_gen provider.
THUMBNAIL_CONCEPT_COUNT=3
THUMBNAIL_RENDER_COUNT=1
QA_PROMPT_VERSION=latest
PUBLISH_PROMPT_VERSION=latest

# --- YouTube provider credentials (Publisher Agent) -----------------------
# Referenced by config/providers.yaml's youtube.youtube_data_api entry.
# OAuth2 refresh-token flow against the YouTube Data API v3
# (libs/providers/youtube/youtube_data_api_provider.py) — access tokens
# are exchanged from the refresh token per call and never written
# anywhere; only these three are durable secrets. Leave all three blank
# until you've completed Google's OAuth consent flow for a real channel;
# `youtube.active` stays "stub" in config/providers.yaml until then, so
# nothing publishes to a real channel by accident.
# YOUTUBE_OAUTH_CLIENT_SECRET is read through the same secret_ref
# mechanism every other provider uses; client id and refresh token are
# read directly by name (configurable via that provider's own `config:`
# block) since the registry only gives each provider one secret_ref slot.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
